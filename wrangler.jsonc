{
  // Must match your Worker's name in the Cloudflare dashboard (Workers & Pages > your project).
  "name": "marufbagwan",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",

  // The whole website lives in /public
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  },

  // Domains served by this Worker. Wrangler attaches them (and creates DNS) on deploy.
  "routes": [
    { "pattern": "marufbagwan.com", "custom_domain": true },
    { "pattern": "www.marufbagwan.com", "custom_domain": true },
    { "pattern": "salesforce.marufbagwan.com", "custom_domain": true }
  ]
}
